---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Communities from '../../components/Communities.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import GetStarted from '../../components/GetStarted.astro';
import FAQ from '../../components/FAQ.astro';
import Footer from '../../components/Footer.astro';

const locale = "nl" as const;
---

<Layout
  title="Mostro-gemeenschap - peer-to-peer handelen in bitcoin met Lightning en Nostr"
  description="Vind een bitcoingemeenschap die Mostro gebruikt en sluit je aan bij de non-custodial P2P-exchange op Lightning en Nostr"
  locale={locale}
>
  <Header locale={locale} />
  <main>
    <Hero locale={locale} />
    <Communities locale={locale} />
    <HowItWorks locale={locale} />
    <FAQ locale={locale} />
    <GetStarted locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
